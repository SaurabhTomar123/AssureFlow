# MunimJi Environment Configuration
ENVIRONMENT=development
LOG_LEVEL=INFO

# Database Connection (Default SQLite for local zero-friction setup, PostgreSQL supported)
DATABASE_URL=sqlite:///./munimji.db
# PostgreSQL Example:
# DATABASE_URL=postgresql://munimji_user:munimji_password@localhost:5432/munimji

# Server Configuration
API_HOST=0.0.0.0
API_PORT=8000

# Telegram Bot Bridge (Optional for live Telegram testing)
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_URL=

# Switch Platform Bridge
SWITCH_GATEWAY_URL=http://localhost:9000
SWITCH_SHARED_SECRET=

# LLM Providers (Optional for external visual OCR)
GEMINI_API_KEY=

