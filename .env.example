# Assure Flow configuration contract (spec section 2). Every variable, with its default.
# Copy to .env. Secrets come only from the environment or Docker secrets.

# --- Core ---
DATABASE_URL=postgresql+psycopg://af:af@localhost:5433/assureflow
FILE_STORAGE_ROOT=./data/files
# demo | test | pilot | production  (must equal the database's environment row)
ENVIRONMENT=demo

# --- Switch (pinned release; see docs/decisions.md D-02) ---
SWITCH_BASE_URL=http://localhost:8080
SWITCH_SERVER_VERSION=
SWITCH_CONSOLE_VERSION=
SWITCH_CREDENTIALS_FILE=./data/switch_credentials.json
ROOM_BINDINGS_FILE=./agents/rooms.yaml
ROOM_CONFIG_VERSION=1

# --- Business-tool API (per-agent tokens prove which agent calls; never which human) ---
BUSINESS_MCP_BIND=127.0.0.1:8765
BUSINESS_MCP_TOKENS_FILE=./data/business_tokens.json

# --- Authority ---
REQUEST_CONTEXT_TTL_SECONDS=900
EXECUTION_GRANT_TTL_HOURS=72
HANDOFF_HOP_LIMIT=3

# --- Extraction provider ---
# fake = replays recorded fixtures by SHA-256 (offline, no key); anthropic = Claude vision extraction
LLM_PROVIDER=fake
LLM_MODEL=claude-opus-5-5
LLM_API_KEY=

# --- Limits and tolerances ---
MAX_UPLOAD_MB=20
MAX_PAGES=20
TAX_LINE_TOLERANCE_INR=0.01
AMOUNT_TOLERANCE_INR=1.00

# --- Worker ---
JOB_MAX_ATTEMPTS=3
JOB_LEASE_SECONDS=120
JOB_HEARTBEAT_SECONDS=30
JOB_BACKOFF_SECONDS=30,120,600
WORKER_FAST_SLOTS=4
WORKER_IO_SLOTS=2
WORKER_SLOW_SLOTS=2
JOB_MAX_DURATION_SECONDS=300
OUTBOX_MAX_ATTEMPTS=20
MODEL_TIMEOUT_SECONDS=60
SWITCH_HTTP_TIMEOUT_SECONDS=10
FETCH_TIMEOUT_SECONDS=30
CPU_TASK_TIMEOUT_SECONDS=90

# --- Scheduling and targets ---
DEFAULT_TZ=Asia/Kolkata
DIGEST_LOCAL_TIME=10:00
QUIET_HOURS=20:00-09:00
DIGEST_ESCALATE_AFTER=2

# --- Disclosure: also check Switch's live room members before each send ---
LIVE_MEMBER_CHECK=true
# Chat usernames allowed in rooms without an Assure Flow identity (e.g. deployment admins)
SWITCH_TRUSTED_USERNAMES=

# --- U2 purchase assurance (docs/purchase-assurance-update.md). Off = v1.4 behaviour, unchanged.
# Shops also opt in (seed/practice.yaml `purchase_assurance: true`).
PURCHASE_ASSURANCE_ENABLED=false

# --- Business-tool MCP server proxies to this API ---
API_BASE_URL=http://127.0.0.1:8000

# --- Synthetic testing room and measurement ---
ACCEPTANCE_TIMEOUT_SECONDS=900
COST_USD_PER_MTOK_INPUT=4
COST_USD_PER_MTOK_OUTPUT=20
USD_INR=88
ACK_TARGET_SECONDS=5
EXTRACTION_TARGET_SECONDS=90
